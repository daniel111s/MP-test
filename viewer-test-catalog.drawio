<diagram name="Rich text" id="rich-text-styles">
    <mxGraphModel dx="900" dy="740" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="900" pageHeight="740" background="#f8fafc">
      <root>
        <mxCell id="rt-root"/>
