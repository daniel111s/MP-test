        <mxCell id="rt-title" value="Rich text styles" style="text;html=1;fontFamily=Arimo;fontSize=26;fontStyle=1;fontColor=#0f172a;align=left;verticalAlign=middle;" vertex="1" parent="rt-layer">
          <mxGeometry x="40" y="12" width="800" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="rt-typography" value="&lt;p style=&quot;margin:0;line-height:1.5&quot;&gt;&lt;b&gt;01 / Typography mix&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:Tinos;font-size:22px;color:#9f1239&quot;&gt;&lt;b&gt;&lt;i&gt;Serif with feeling&lt;/i&gt;&lt;/b&gt;&lt;/span&gt; meets &lt;span style=&quot;font-family:Cousine;font-size:13px;color:#1d4ed8&quot;&gt;&lt;u&gt;precise code&lt;/u&gt;&lt;/span&gt; and &lt;span style=&quot;font-family:Noto Sans;font-size:18px&quot;&gt;&lt;s&gt;old ideas&lt;/s&gt;&lt;/span&gt;. Water is H&lt;sub&gt;2&lt;/sub&gt;O and energy is E = mc&lt;sup&gt;2&lt;/sup&gt;. &lt;span style=&quot;letter-spacing:1px;word-spacing:3px;text-transform:uppercase&quot;&gt;room to breathe&lt;/span&gt;. &lt;small&gt;Small print&lt;/small&gt; and &lt;big&gt;big plans&lt;/big&gt;.&lt;/p&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontFamily=Arimo;fontSize=15;fontColor=#243247;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="rt-layer">
          <mxGeometry x="40" y="60" width="380" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="rt-typography-caption" value="&lt;div style=&quot;line-height:1&quot;&gt;html: 1 | whiteSpace: wrap | align: left&lt;br&gt;verticalAlign: top | spacing: 12&lt;br&gt;fontFamily: Arimo | fontSize: 15 | fontColor: #243247&lt;br&gt;&amp;lt;p&amp;gt; margin: 0 | line-height: 1.5 | &amp;lt;br&amp;gt;&lt;br&gt;&amp;lt;b&amp;gt; &amp;lt;i&amp;gt; &amp;lt;u&amp;gt; &amp;lt;s&amp;gt; &amp;lt;sub&amp;gt; &amp;lt;sup&amp;gt; &amp;lt;small&amp;gt; &amp;lt;big&amp;gt;&lt;br&gt;font-family: Tinos, Cousine, Noto Sans&lt;br&gt;font-size: 22px, 13px, 18px&lt;br&gt;color: #9f1239, #1d4ed8&lt;br&gt;letter-spacing: 1px | word-spacing: 3px&lt;br&gt;text-transform: uppercase&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Cousine;fontSize=10;fontColor=#334155;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="rt-layer">
          <mxGeometry x="40" y="285" width="390" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="rt-layout" value="&lt;h3 style=&quot;margin:0 0 4px 0&quot;&gt;02 / Layout mix&lt;/h3&gt;&lt;p style=&quot;margin:0;text-align:left;line-height:1.2&quot;&gt;A paragraph on the left.&lt;br&gt;A deliberate line break.&lt;/p&gt;&lt;div style=&quot;text-align:center&quot;&gt;A centered interlude&lt;/div&gt;&lt;div style=&quot;text-align:right&quot;&gt;A right aligned reply&lt;/div&gt;&lt;ol start=&quot;3&quot; style=&quot;margin:4px 0&quot;&gt;&lt;li&gt;A numbered idea&lt;ul style=&quot;margin:0&quot;&gt;&lt;li&gt;A nested bullet&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;A second idea&lt;/li&gt;&lt;/ol&gt;&lt;pre style=&quot;margin:0;white-space:pre-wrap&quot;&gt;  keep  these  spaces&lt;/pre&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontFamily=Arimo;fontSize=15;fontColor=#243247;align=left;verticalAlign=top;spacing=12;spacingTop=0;spacingRight=2;spacingBottom=0;spacingLeft=4;" vertex="1" parent="rt-layer">
          <mxGeometry x="460" y="60" width="380" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="rt-layout-caption" value="&lt;div style=&quot;line-height:1&quot;&gt;html: 1 | whiteSpace: wrap | align: left&lt;br&gt;verticalAlign: top | spacing: 12&lt;br&gt;spacingTop: 0 | spacingBottom: 0 | spacingRight: 2&lt;br&gt;spacingLeft: 4 | fontFamily: Arimo | fontSize: 15&lt;br&gt;fontColor: #243247 | &amp;lt;h3&amp;gt; &amp;lt;p&amp;gt; &amp;lt;div&amp;gt; &amp;lt;br&amp;gt;&lt;br&gt;text-align: left, center, right | line-height: 1.2&lt;br&gt;&amp;lt;ol start=&quot;3&quot;&amp;gt; &amp;lt;li&amp;gt; &amp;lt;ul&amp;gt; &amp;lt;pre&amp;gt;&lt;br&gt;margin: 0, 0 0 4px 0, 4px 0&lt;br&gt;white-space: pre-wrap | nested list indentation&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Cousine;fontSize=10;fontColor=#334155;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="rt-layer">
          <mxGeometry x="460" y="285" width="390" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="rt-decoration" value="&lt;div style=&quot;line-height:1.5&quot;&gt;03 / Decoration mix&lt;br&gt;&lt;span style=&quot;background-color:#fef08a;color:#854d0e&quot;&gt;&lt;i&gt;Highlighted and italic&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color:#dcfce7;color:#166534&quot;&gt;&lt;s&gt;A revised decision&lt;/s&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;border:1px dashed #0284c7;border-radius:4px;padding:3px&quot;&gt;A framed &lt;sup&gt;bright&lt;/sup&gt; idea&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px;color:#075985&quot;&gt;A little tilt and a soft echo&lt;/span&gt;&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontFamily=Arimo;fontSize=15;fontColor=#243247;align=left;verticalAlign=top;spacing=12;fontStyle=5;rotation=3;labelBackgroundColor=#f0f9ff;labelBorderColor=#38bdf8;labelBorderWidth=1;labelPadding=6;textOpacity=90;textShadow=1;shadowColor=#94a3b8;shadowOffsetX=1;shadowOffsetY=1;shadowBlur=0;shadowOpacity=35;" vertex="1" parent="rt-layer">
          <mxGeometry x="40" y="385" width="380" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="rt-decoration-caption" value="&lt;div style=&quot;line-height:1&quot;&gt;html: 1 | whiteSpace: wrap | fontStyle: 5&lt;br&gt;fontFamily: Arimo | fontSize: 15 | rotation: 3&lt;br&gt;fontColor: #243247 | align: left | verticalAlign: top&lt;br&gt;spacing: 12 | labelPadding: 6 | textOpacity: 90&lt;br&gt;labelBackgroundColor: #f0f9ff&lt;br&gt;labelBorderColor: #38bdf8 | labelBorderWidth: 1&lt;br&gt;textShadow: 1 | shadowColor: #94a3b8 | shadowOpacity: 35&lt;br&gt;shadowOffsetX: 1 | shadowOffsetY: 1 | shadowBlur: 0&lt;br&gt;&amp;lt;div&amp;gt; &amp;lt;br&amp;gt; &amp;lt;i&amp;gt; &amp;lt;s&amp;gt; &amp;lt;sup&amp;gt; | line-height: 1.5&lt;br&gt;background-color: #fef08a, #dcfce7&lt;br&gt;color: #854d0e, #166534, #075985 | font-size: 19px&lt;br&gt;border: 1px dashed #0284c7 | border-radius: 4px | padding: 3px&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Cousine;fontSize=10;fontColor=#334155;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="rt-layer">
          <mxGeometry x="40" y="610" width="390" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="rt-complex" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b&gt;04 / Complex mix&lt;/b&gt;&lt;br&gt;&lt;a href=&quot;https://example.com&quot; style=&quot;color:#1d4ed8;text-decoration:underline&quot;&gt;A linked reference&lt;/a&gt; &amp;amp; entities: &amp;lt;tag&amp;gt; &amp;copy; &amp;nbsp; &amp;#9733;&lt;br&gt;&lt;span style=&quot;color:#0f766e;font-family:Tinos;font-size:18px&quot;&gt;Inherited teal &lt;span style=&quot;color:#be123c;font-family:Cousine;font-size:13px&quot;&gt;nested ruby&lt;/span&gt; teal again&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Noto Sans&quot;&gt;Polski: żółw · Ελληνικά · Кириллица&lt;/span&gt;&lt;br&gt;&lt;span&gt;日本語 中文 한글 😀 ✨&lt;/span&gt;&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;font-size:13px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th&gt;State&lt;/th&gt;&lt;th&gt;Meaning&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background-color:#dcfce7&quot;&gt;Ready&lt;/td&gt;&lt;td&gt;&lt;b&gt;Ship it&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontFamily=Arimo;fontSize=15;fontColor=#243247;align=left;verticalAlign=top;spacing=12;fontColor=#6b21a8;textDirection=ltr;" vertex="1" parent="rt-layer">
